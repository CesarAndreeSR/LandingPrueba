---
---

<div id="preloader" class="preloader-overlay">
  <!-- Ambient glow behind the sun -->
  <div class="preloader-glow" id="preloader-glow"></div>

  <!-- Sun & Logo Container -->
  <div class="preloader-sun-area">
    <!-- Outer Sun Rays (Clockwise) -->
    <div class="sun-ring sun-ring-outer" id="sun-ring-outer">
      {Array.from({ length: 16 }).map((_, i) => (
        <div class="sun-ray sun-ray-outer" style={`--angle: ${i * 22.5}deg`}></div>
      ))}
    </div>

    <!-- Inner Sun Rays (Counter-Clockwise) -->
    <div class="sun-ring sun-ring-inner" id="sun-ring-inner">
      {Array.from({ length: 12 }).map((_, i) => (
        <div class="sun-ray sun-ray-inner" style={`--angle: ${i * 30 + 15}deg`}></div>
      ))}
    </div>

    <!-- Central Logo Badge -->
    <div class="logo-badge" id="preloader-logo-badge">
      <img src="/IntiLogo.svg" alt="Intihawua" class="logo-badge-img" id="preloader-logo" />
    </div>
  </div>

  <!-- Brand Text -->
  <div class="preloader-text-wrap">
    <h2 class="preloader-brand-text" id="preloader-text">Intihawua</h2>
  </div>

  <!-- Progress -->
  <div class="preloader-progress">
    <div class="preloader-percent" id="loading-percent">0%</div>
    <div class="preloader-track">
      <div class="preloader-bar" id="preloader-bar"></div>
    </div>
  </div>
</div>

<style>
  /* ── Overlay ── */
  .preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;                       /* above header z-[100] */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 15% 20%, rgba(10, 88, 202, 0.22) 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(255, 102, 0, 0.18) 0%, transparent 50%),
      linear-gradient(135deg, #0B132B 0%, #060e22 50%, #020716 100%);
  }

  /* ── Ambient Glow ── */
  .preloader-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle,
      rgba(255, 170, 0, 0.18) 0%,
      rgba(255, 102, 0, 0.12) 30%,
      rgba(10, 88, 202, 0.08) 60%,
      transparent 80%
    );
    filter: blur(50px);
    pointer-events: none;
    opacity: 0;
  }

  /* ── Sun Area ── */
  .preloader-sun-area {
    position: relative;
    width: 260px;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ── Sun Ring ── */
  .sun-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .sun-ring-outer {
    animation: spin-cw 20s linear infinite;
  }

  .sun-ring-inner {
    inset: 20px;
    animation: spin-ccw 15s linear infinite;
  }

  /* ── Rays ── */
  .sun-ray {
    position: absolute;
    left: 50%;
    top: 0;
    transform-origin: 50% 50cqw; /* fallback below */
    transform-origin: 50% calc(50%);
  }

  .sun-ray-outer {
    width: 4px;
    height: 38px;
    left: calc(50% - 2px);
    top: 0;
    border-radius: 4px;
    background: linear-gradient(to bottom, #FF6600, rgba(255, 170, 0, 0.15));
    transform-origin: 2px 130px;
    transform: rotate(var(--angle));
    box-shadow: 0 0 8px rgba(255, 102, 0, 0.4);
  }

  .sun-ray-inner {
    width: 3px;
    height: 28px;
    left: calc(50% - 1.5px);
    top: 0;
    border-radius: 3px;
    background: linear-gradient(to bottom, #0099FF, rgba(10, 88, 202, 0.1));
    transform-origin: 1.5px 110px;
    transform: rotate(var(--angle));
    box-shadow: 0 0 6px rgba(0, 153, 255, 0.35);
  }

  /* ── Logo Badge ── */
  .logo-badge {
    position: relative;
    z-index: 10;
    width: 160px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 30px rgba(255, 170, 0, 0.3)) drop-shadow(0 0 60px rgba(10, 88, 202, 0.2));
    opacity: 0;
    transform: scale(0.4);
  }

  .logo-badge-img {
    width: 110px;
    height: 110px;
    object-fit: contain;
  }

  /* ── Brand Text ── */
  .preloader-text-wrap {
    overflow: hidden;
    margin-top: 24px;
  }

  .preloader-brand-text {
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1em;
    color: rgba(255, 255, 255, 0.9);
    opacity: 0;
    transform: translateY(100%);
  }

  /* ── Progress ── */
  .preloader-progress {
    position: absolute;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .preloader-percent {
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.5);
  }

  .preloader-track {
    width: 180px;
    height: 3px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .preloader-bar {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    background: linear-gradient(90deg, #0099FF, #FF6600);
    box-shadow: 0 0 12px rgba(255, 102, 0, 0.5);
    transition: width 0.15s ease-out;
  }

  /* ── Keyframes ── */
  @keyframes spin-cw {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes spin-ccw {
    from { transform: rotate(0deg); }
    to   { transform: rotate(-360deg); }
  }
</style>

<script is:inline>
  // FAIL-SAFE: Ocultar el preloader si algo falla después de 3 segundos
  setTimeout(function () {
    var preloader = document.getElementById('preloader');
    if (preloader && preloader.style.display !== 'none') {
      preloader.style.transition = 'opacity 0.5s ease';
      preloader.style.opacity = '0';
      setTimeout(function () {
        preloader.style.display = 'none';
        document.body.style.overflow = 'auto';
        document.body.classList.remove('overflow-hidden');
        window.preloaderDone = true;
        window.dispatchEvent(new CustomEvent('preloaderComplete'));
      }, 500);
    }
  }, 3000);
</script>

<script>
  import anime from 'animejs';

  const startAnimation = () => {
    const preloader = document.getElementById('preloader');
    const logoBadge = document.getElementById('preloader-logo-badge');
    const text = document.getElementById('preloader-text');
    const bar = document.getElementById('preloader-bar');
    const percentText = document.getElementById('loading-percent');
    const sunOuter = document.getElementById('sun-ring-outer');
    const sunInner = document.getElementById('sun-ring-inner');
    const glow = document.getElementById('preloader-glow');

    if (!preloader || !bar) return;

    const tl = anime.timeline({ easing: 'easeOutExpo' });

    tl
    // 1. Progress bar fills up — parallel animations fire inside begin()
    .add({
      targets: bar,
      width: '100%',
      duration: 1500,
      update: (anim) => {
        if (percentText) percentText.textContent = `${Math.round(anim.progress)}%`;
      },
      begin: () => {
        // Ambient glow fades in
        anime({ targets: glow, opacity: [0, 1], scale: [0.6, 1], duration: 1200, easing: 'easeOutQuad' });

        // Outer sun rays scale in with elastic bounce
        anime({ targets: sunOuter, scale: [0.2, 1], opacity: [0, 1], duration: 1000, easing: 'easeOutElastic(1, .7)' });

        // Inner sun rays scale in slightly later
        anime({ targets: sunInner, scale: [0.2, 1], opacity: [0, 1], duration: 1100, delay: 150, easing: 'easeOutElastic(1, .7)' });

        // Logo badge pops in
        anime({ targets: logoBadge, scale: [0.4, 1], opacity: [0, 1], duration: 800, delay: 200, easing: 'easeOutBack' });
      }
    })
    // 2. Brand text slides up
    .add({
      targets: text,
      translateY: ['100%', '0%'],
      opacity: [0, 1],
      letterSpacing: ['2em', '1em'],
      duration: 600,
      easing: 'easeOutCubic',
    }, '-=800')
    // 3. Preloader fades out & dispatches event
    .add({
      targets: preloader,
      opacity: 0,
      duration: 500,
      delay: 200,
      easing: 'easeInQuad',
      complete: () => {
        preloader.style.display = 'none';
        document.body.classList.remove('overflow-hidden');
        window.preloaderDone = true;
        window.dispatchEvent(new CustomEvent('preloaderComplete'));
      }
    });
  };

  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    startAnimation();
  } else {
    document.addEventListener('DOMContentLoaded', startAnimation);
  }
</script>
