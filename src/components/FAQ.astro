---
const faqs = [
  { 
    q: "¿Cuánto tiempo toma el trabajo?", 
    a: "Una página web demora entre 7 y 10 días. Un sistema completo para tu negocio puede tomar entre 15 y 45 días, dependiendo de lo que necesites." 
  },
  { 
    q: "¿Funciona en celulares y tablets?", 
    a: "Sí, funciona en cualquier dispositivo. Podrás revisar tu negocio desde donde estés, solo necesitas internet." 
  },
  { 
    q: "¿Me enseñarán a usar el sistema?", 
    a: "Claro que sí. Te daremos una capacitación y te entregaremos videos paso a paso para que tú y tu equipo aprendan rápido. Además, siempre estamos para ayudarte." 
  },
  { 
    q: "¿Puedo dar boletas de la SUNAT?", 
    a: "Sí. El sistema está conectado con la SUNAT para que puedas dar boletas y facturas de forma automática y legal." 
  },
  { 
    q: "¿Qué pasa con mis datos actuales?", 
    a: "Nosotros te ayudamos. Pasamos tu lista de productos y clientes al nuevo sistema para que no pierdas nada y empieces a trabajar de inmediato." 
  },
  { 
    q: "¿Cómo es el proceso de pago?", 
    a: "Se paga el 50% al iniciar el trabajo y el otro 50% cuando el proyecto esté terminado y tú estés conforme con el resultado." 
  },
];
---

<section id="faq" class="relative bg-white py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Left: Header -->
      <div class="reveal">
        <span class="eyebrow">Dudas frecuentes</span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl leading-[1.1]">Preguntas Frecuentes</h2>
        <p class="mt-4 text-base text-slate-600">Aquí respondemos tus dudas principales para que empieces con confianza.</p>
        
        <div class="mt-8 p-6 rounded-[2rem] bg-cobalt-50 border border-cobalt-100">
          <h4 class="font-bold text-ink mb-3">¿Tienes otra pregunta?</h4>
          <p class="text-xs text-slate-500 mb-4">Escríbenos y te ayudaremos con cualquier detalle.</p>
          <a href="#contacto" class="inline-flex items-center gap-2 text-xs font-extrabold text-cobalt-500 hover:text-cobalt-600 transition-colors">
            Hablar con nosotros <span>→</span>
          </a>
        </div>
      </div>

      <!-- Right: Accordion -->
      <div class="lg:col-span-2 space-y-3">
        {faqs.map((faq) => (
          <details class="reveal group rounded-2xl border border-slate-100 bg-white p-1 transition-all duration-300 hover:border-cobalt-200 open:border-cobalt-200 open:shadow-lg open:shadow-cobalt-500/5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-bold text-ink transition-colors group-hover:text-cobalt-500">
              <span class="flex-1">{faq.q}</span>
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-50 text-slate-400 group-open:rotate-180 group-open:bg-cobalt-500 group-open:text-white transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </span>
            </summary>
            <div class="px-5 pb-5 text-sm leading-relaxed text-slate-500">
              <div class="pt-2 border-t border-slate-50">
                {faq.a}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
