---
const { whatsapp } = Astro.props;
---

<section id="contacto" class="relative bg-ink py-20 lg:py-32 overflow-hidden">
  <!-- Dynamic Dark Background -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-[-20%] right-[-10%] w-[600px] h-[600px] bg-cobalt-500/15 rounded-full blur-[120px] animate-pulse-soft"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[500px] h-[500px] bg-ember-500/15 rounded-full blur-[100px] animate-pulse-soft" style="animation-delay: 3s;"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8 z-10">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div class="gsap-reveal space-y-10">
        <span class="text-[10px] font-black uppercase tracking-[0.4em] text-ember-500">¿Empezamos con tu proyecto?</span>
        <h2 class="text-4xl font-black text-white sm:text-6xl tracking-tight leading-[0.85]">Hagamos realidad <span class="text-cobalt-500 italic">tu idea</span> hoy mismo.</h2>
        
        <div class="space-y-6">
          <p class="text-xl text-slate-300 font-medium leading-relaxed max-w-lg">
            Únete a los negocios que ya están creciendo y ordenándose con nuestros sistemas.
          </p>
          
          <div class="flex flex-wrap gap-6">
            <div class="flex items-center gap-3 group cursor-default">
              <div class="h-10 w-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-ember-500 group-hover:bg-ember-500 group-hover:text-white transition-all shadow-[0_0_20px_rgba(247,120,11,0.2)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              </div>
              <span class="text-xs font-black text-white uppercase tracking-widest">Te ayudamos en todo</span>
            </div>
            <div class="flex items-center gap-3 group cursor-default">
              <div class="h-10 w-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-cobalt-500 group-hover:bg-cobalt-500 group-hover:text-white transition-all shadow-[0_0_20px_rgba(6,109,200,0.2)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <span class="text-xs font-black text-white uppercase tracking-widest">Datos seguros</span>
            </div>
          </div>
        </div>
      </div>

      <div class="gsap-reveal">
        <div class="glass-dark p-8 sm:p-12 rounded-[3rem] border-white/5 shadow-2xl relative group">
          <!-- Form Header -->
          <div class="mb-10">
            <h3 class="text-2xl font-black text-white tracking-tighter">Cuéntanos tu idea</h3>
            <p class="text-slate-400 mt-2 font-medium text-sm">Déjanos tus datos y te contactaremos pronto.</p>
          </div>
          
          <form class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
              <input 
                type="text" 
                placeholder="Nombre" 
                class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-slate-500 focus:border-cobalt-500 focus:outline-none transition-all font-bold text-sm"
                required
              />
            </div>
            <div class="space-y-2">
              <input 
                type="email" 
                placeholder="Correo electrónico" 
                class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-slate-500 focus:border-cobalt-500 focus:outline-none transition-all font-bold text-sm"
                required
              />
            </div>
            <div class="space-y-2">
              <input 
                type="tel" 
                placeholder="WhatsApp" 
                class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-slate-500 focus:border-cobalt-500 focus:outline-none transition-all font-bold text-sm"
                required
              />
            </div>
            <div class="space-y-2">
              <div class="relative">
                <select 
                  class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-slate-400 focus:border-cobalt-500 focus:outline-none transition-all appearance-none font-bold text-sm"
                  required
                >
                  <option value="" disabled selected class="bg-ink">Tipo de proyecto</option>
                  <option value="enterprise" class="bg-ink text-white">Sistema para mi empresa</option>
                  <option value="saas" class="bg-ink text-white">Sistema en la nube</option>
                  <option value="web-pro" class="bg-ink text-white">Página web profesional</option>
                  <option value="otro" class="bg-ink text-white">Asesoría técnica</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                  <svg class="h-4 w-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                </div>
              </div>
            </div>
            <div class="sm:col-span-2 space-y-2">
              <textarea 
                rows="3" 
                placeholder="¿Qué es lo que necesitas?..." 
                class="w-full rounded-2xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-slate-500 focus:border-cobalt-500 focus:outline-none transition-all resize-none font-bold text-sm"
                required
              ></textarea>
            </div>
            <div class="sm:col-span-2 mt-4">
              <button 
                type="submit" 
                class="btn-saas btn-saas-primary w-full px-8 py-4 text-xs uppercase tracking-[0.2em]"
              >
                Enviar información
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
