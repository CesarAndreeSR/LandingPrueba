---
const { nav, whatsapp } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-[100]  duration-500 bg-white" id="main-header">
  <div class="mx-auto max-w-6xl px-4 py-4 lg:px-6">
    <nav class="flex items-center justify-between">
      <a href="#inicio" class="flex items-center gap-3 group">
        <div class="h-10 w-20 flex">
          <img src="/IntiLogo.svg" alt="Intihawua" />
        </div>
        <div class="hidden sm:block">
          <span class="block text-[15px] font-black uppercase tracking-[0.4em] text-[#0B132B] leading-none">Intihawua</span>
          <span class="text-[8px] font-bold uppercase tracking-[0.1em] text-[#5C677D] mt-1 block">Software para tu negocio</span>
        </div>
      </a>

      <div class="hidden items-center gap-8 lg:flex">
        {nav.map(([label, href]) => (
          <!-- Solo borramos la palabra "uppercase" de las clases -->
          <a href={href} class="text-[13px] font-black tracking-[0.1em] text-[#0B132B] transition-all hover:text-[#0A58CA] hover:tracking-[0.2em]">{label}</a>
        ))}
      </div>

      <div class="flex items-center gap-4">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-[#FF6600] px-6 py-3 text-[9px] font-black uppercase tracking-[0.1em] text-white transition-all hover:bg-[#FFAA00] hover:shadow-lg hover:shadow-[#FF6600]/30 active:scale-95">
          Información
        </a>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="sm:hidden inline-flex items-center justify-center h-10 w-10 rounded-xl bg-[#FF6600] text-white shadow-lg shadow-[#FF6600]/30 active:scale-90 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const footer = document.getElementById('contacto');
  const qoriChat = document.getElementById('qori-chatbot');

  // Ocultar header y chat cuando el footer es visible
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        header?.classList.add('-translate-y-full', 'opacity-0');
        qoriChat?.classList.add('-translate-y-20', 'opacity-0', 'pointer-events-none');
      } else {
        header?.classList.remove('-translate-y-full', 'opacity-0');
        qoriChat?.classList.remove('-translate-y-20', 'opacity-0', 'pointer-events-none');
      }
    });
  }, { threshold: 0.1 });

  if (footer) {
    observer.observe(footer);
  }

  // Mantener el comportamiento original de padding al hacer scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
        header?.classList.add('border-b', 'border-black/25', );
    } else {
        header?.classList.remove('border-b', 'border-black/10', );
    }
});
</script>
