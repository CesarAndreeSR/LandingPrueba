---
---

<section id="sobre-mi" class="relative bg-white py-12 lg:py-16 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Media Content (High-End Agency Style) -->
      <div class="gsap-reveal relative order-2 lg:order-1">
        <div class="relative group/about overflow-visible">
          <!-- Main Video/Image Frame -->
          <div class="relative z-10 rounded-[2rem] overflow-hidden shadow-2xl bg-slate-900 aspect-video transform group-hover/about:scale-[1.01] transition-transform duration-1000">
            <video
                class="w-full h-full object-cover opacity-90 group-hover/about:opacity-100 transition-opacity duration-1000"
                autoplay
                muted
                loop
                playsinline
            >
                <source src="/videos/intihawua.mp4" type="video/mp4">
            </video>
            <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
            
            <!-- Content on Video -->
            <div class="absolute bottom-0 left-0 p-8 w-full">
              <div class="flex items-center gap-4 mb-2">
                <div class="h-px w-8 bg-ember-500"></div>
                <span class="text-[8px] font-black uppercase tracking-[0.2em] text-white/70">Nuestra Meta</span>
              </div>
              <h4 class="text-xl font-black text-white leading-tight">Software que ayuda a tu negocio.</h4>
            </div>
          </div>
        </div>
      </div>

      <!-- Text Content (Authority & Trust) -->
      <div class="gsap-reveal order-1 lg:order-2 space-y-10">
        <div>
          <h2 class="mt-6 text-4xl font-black tracking-tight text-ink sm:text-6xl leading-[0.9]">
            Expertos en crear <span class="text-cobalt-500">software</span> para tu negocio.
          </h2>
        </div>
        
        <p class="text-xl text-slate-500 leading-relaxed font-medium">
          Te ayudamos a que tu empresa crezca con la mejor tecnología, haciendo que tus procesos sean más rápidos y sin errores.
        </p>

        <div class="mt-12 pt-10 border-t border-slate-100 flex flex-col sm:flex-row items-center gap-8">
          <div class="flex -space-x-4">
            {[1, 2, 3, 4, 5].map((i) => (
              <div class="h-12 w-12 rounded-full border-[4px] border-white bg-slate-100 overflow-hidden shadow-lg transform hover:scale-110 hover:z-30 transition-all duration-500 cursor-pointer">
                <img src={`https://i.pravatar.cc/150?u=${i + 20}`} alt="Líder de Proyecto" class="h-full w-full object-cover" />
              </div>
            ))}
          </div>
          <div class="text-center sm:text-left">
            <div class="text-xl font-black text-ink tracking-tighter">Únete a los mejores.</div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Sé parte de Intihawua.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
