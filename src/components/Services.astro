---
const services = [
  {
    title: "Sistemas POS e Inventario",
    description: "Controla tus ventas, productos y clientes desde cualquier dispositivo.",
    icon: "🛒",
    bullets: ["Ventas rápidas y fáciles", "Control de stock en tiempo real", "Reportes de ventas y ganancias", "Integración con SUNAT", "Multiusuario y permisos"],
    image: "/img/pos.png",
    buttonText: "Ver demo del sistema",
    buttonLink: "#proyectos"
  },
  {
    title: "Páginas Web Profesionales",
    description: "Diseñamos páginas modernas que transmiten confianza y atraen clientes.",
    icon: "🌐",
    bullets: ["Diseño responsive (móvil y desktop)", "Velocidad y SEO optimizado", "Formulario de contacto y WhatsApp", "Hosting y dominio", "Autoadministrable"],
    image: "/img/web.png",
    buttonText: "Ver ejemplos de páginas",
    buttonLink: "#proyectos"
  }
];
---

<section id="servicios" class="bg-bone-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="mx-auto max-w-3xl text-center reveal">
      <span class="eyebrow text-ember-600">Servicios</span>
      <h2 class="mt-3 text-4xl font-extrabold tracking-[-0.04em] text-ink sm:text-5xl">Soluciones que se adaptan a tu negocio</h2>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-2 reveal-group">
      {services.map((service) => (
        <div class="reveal-scale group relative flex flex-col rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm transition-all hover:shadow-2xl hover:shadow-cobalt-900/10 overflow-hidden">
          <div class="flex items-center gap-4 mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-ember-50 text-2xl shadow-sm group-hover:scale-110 transition-transform">{service.icon}</div>
            <div>
              <h3 class="text-2xl font-extrabold tracking-tight text-ink">{service.title}</h3>
              <p class="text-sm text-slate-500 font-medium">{service.description}</p>
            </div>
          </div>
          
          <div class="grid sm:grid-cols-2 gap-8 items-start">
            <ul class="space-y-3">
              {service.bullets.map((bullet) => (
                <li class="flex items-center gap-3 text-sm font-semibold text-slate-700">
                  <span class="text-ember-500">✓</span>
                  {bullet}
                </li>
              ))}
            </ul>
            <div class="relative rounded-xl border border-slate-100 bg-slate-50 p-2 shadow-inner overflow-hidden aspect-[4/3] sm:aspect-auto">
              <img src={service.image} alt={service.title} class="rounded-lg w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
          
          <div class="mt-8 pt-6 border-t border-slate-100">
            <a href={service.buttonLink} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 rounded-xl bg-ember-500 text-white font-bold text-sm shadow-lg shadow-ember-500/20 hover:bg-ember-600 transition-colors">
              {service.buttonText}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
