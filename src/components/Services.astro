---
const services = [
  {
    id: "sistemas",
    title: "Sistemas para cobrar y vender",
    description: "Creamos el corazón de tu negocio. Un sistema fácil para controlar todo sin errores.",
    features: [
      { title: "Control de productos", desc: "Sabe siempre cuánto tienes en almacén y recibe avisos cuando falte algo." },
      { title: "Ventas y Boletas", desc: "Cobra rápido y envía boletas o facturas a la SUNAT automáticamente." },
      { title: "Resumen de ventas", desc: "Mira cuánto vas vendiendo cada día con gráficos simples y claros." },
      { title: "Úsalo donde quieras", desc: "Entra a tu sistema desde cualquier celular o computadora con internet." }
    ],
    image: "/img/laptop.png",
    buttonText: "Ver qué puede hacer",
    icon: "💻",
    demos: [
      { name: "Demo Pastelería", url: "https://demo.intihawua.app/pasteleria" },
      { name: "Demo Sistema de Cobranzas", url: "https://demo.intihawua.app/cobranzas" }
    ]
  },
  {
    id: "web",
    title: "Páginas web profesionales",
    description: "No solo hacemos páginas, creamos herramientas para que más clientes te encuentren y te compren.",
    icon: "💎",
    features: [
      { title: "Diseño moderno", desc: "Tu página se verá profesional y dará mucha confianza a tus clientes." },
      { title: "Hecha para vender", desc: "Todo está puesto en el lugar correcto para que te escriban o te compren." },
      { title: "Carga muy rápido", desc: "Tus clientes no esperarán. La página abre al instante en cualquier celular." },
      { title: "Aparece en Google", desc: "Ayudamos a que tu negocio salga en los primeros resultados cuando te busquen." }
    ],
    image: "/img/imgweb.png",
    buttonText: "Ver modelos",
    demos: [
      { name: "Página Clínica Premium", url: "https://demo.intihawua.app/clinica" }
    ]
  }
];
---

<section id="servicios" class="bg-white py-12 lg:py-16 relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-4xl mb-24 gsap-reveal">
      <span class="eyebrow">Nuestras Soluciones</span>
      <h2 class="mt-6 text-4xl font-black tracking-tight text-[#0B132B] sm:text-6xl leading-[0.9]">Hacemos que tu <span class="text-[#0A58CA]">negocio</span> crezca con tecnología.</h2>
    </div>

    <div class="space-y-20">
      {services.map((service, index) => (
        <div class={`group flex flex-col lg:flex-row items-center gap-16 ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''} gsap-reveal`}>
          <!-- Content Side -->
          <div class="flex-1 space-y-10">
            
            <div class="space-y-6">
              <h3 class="text-4xl font-black text-[#0B132B] sm:text-5xl tracking-tighter leading-none group-hover:text-[#0A58CA] transition-colors duration-500">{service.title}</h3>
              <p class="text-xl text-[#5C677D] leading-relaxed max-w-xl font-medium">{service.description}</p>
            </div>

            <!-- Accordion Style Features -->
            <div class="space-y-4 pt-2">
              {service.features.map((feature) => (
                <details class="group/item border-b border-slate-100 pb-4 cursor-pointer">
                  <summary class="flex items-center justify-between list-none font-black text-[#0B132B] text-lg py-2 hover:text-[#0A58CA] transition-colors">
                    {feature.title}
                    <span class="text-slate-300 group-open/item:rotate-180 group-open/item:text-[#0A58CA] transition-all duration-500">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </span>
                  </summary>
                  <div class="pt-3 text-[#5C677D] leading-relaxed text-base font-medium">
                    {feature.desc}
                  </div>
                </details>
              ))}
            </div>

            <div class="pt-6">
              <button 
                data-service-id={service.id}
                class="demo-btn px-10 py-5 text-xs uppercase tracking-[0.2em] rounded-xl bg-[#FF6600] text-white font-black transition-all hover:bg-[#FFAA00] hover:shadow-lg hover:shadow-[#FF6600]/30 active:scale-95"
              >
                {service.buttonText}
              </button>
            </div>
          </div>

          <!-- Image Side -->
          <div class="flex-1 w-full relative">
            <div class="relative group/img">
              <div class="relative transform group-hover/img:scale-[1.02] group-hover/img:-rotate-1 transition-all duration-1000 ease-out">
                <img src={service.image} alt={service.title} class="w-full h-auto drop-shadow-[0_30px_50px_rgba(0,0,0,0.1)]" />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Glassmorphism Demo Modal -->
  <div id="demo-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-6">
    <div class="absolute inset-0 bg-ink/70 backdrop-blur-2xl transition-opacity duration-500" id="modal-overlay"></div>
    
    <div class="relative w-full max-w-lg glass p-10 lg:p-12 rounded-[3rem] shadow-2xl transform transition-all duration-700 scale-95 opacity-0 translate-y-8" id="modal-content">
      <button class="absolute top-8 right-8 text-slate-400 hover:text-ink transition-colors" id="close-modal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <div class="text-center mb-10">
        <div id="modal-icon" class="inline-flex h-20 w-20 items-center justify-center rounded-[2rem] bg-white shadow-xl text-5xl mb-6 border border-slate-50"></div>
        <h3 id="modal-title" class="text-3xl font-black text-ink tracking-tighter">Probar ahora</h3>
        <p class="text-slate-500 mt-2 text-base font-medium">Mira cómo funciona en un negocio real.</p>
      </div>

      <div id="demo-list" class="space-y-4">
        <!-- Injected via script -->
      </div>
    </div>
  </div>
</section>

<script define:vars={{ services }}>
  const modal = document.getElementById('demo-modal');
  const modalContent = document.getElementById('modal-content');
  const overlay = document.getElementById('modal-overlay');
  const closeBtn = document.getElementById('close-modal');
  const demoList = document.getElementById('demo-list');
  const modalTitle = document.getElementById('modal-title');
  const modalIcon = document.getElementById('modal-icon');

  function openModal(serviceId) {
    const service = services.find(s => s.id === serviceId);
    if (!service) return;

    modalIcon.textContent = service.icon;
    modalTitle.textContent = service.title;
    
    demoList.innerHTML = '';
    service.demos.forEach(demo => {
      const btn = document.createElement('button');
      btn.className = 'w-full flex items-center justify-between gap-6 p-8 rounded-[2rem] bg-white border border-slate-100 hover:border-cobalt-500 hover:shadow-2xl hover:shadow-cobalt-500/10 transition-all group text-left';
      btn.innerHTML = `
        <div>
          <span class="block text-[10px] font-black text-slate-300 uppercase tracking-widest mb-1">Empresa Real</span>
          <span class="text-xl font-black text-ink group-hover:text-cobalt-600 transition-colors uppercase tracking-tight">${demo.name}</span>
        </div>
        <div class="h-12 w-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-300 group-hover:bg-cobalt-500 group-hover:text-white transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </div>
      `;
      btn.onclick = () => window.open(demo.url, '_blank');
      demoList.appendChild(btn);
    });

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    
    setTimeout(() => {
      modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-12');
      modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    }, 10);
  }

  function closeModal() {
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-12');
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }, 500);
  }

  document.querySelectorAll('.demo-btn').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.dataset.serviceId));
  });

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
