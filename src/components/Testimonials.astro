---
const testimonials = [
  {
    name: "Bodega San Martín",
    location: "Pucallpa",
    quote: "El sistema nos ayudó a llevar el control de nuestra bodega. Ahora sabemos todo lo que entra y sale. 100% recomendado.",
    stars: 5
  },
  {
    name: "Clínica Dental Sonrisas",
    location: "Pucallpa",
    quote: "Nuestra clínica maneja citas, pacientes e historias clínicas en un solo sistema. Excelente soporte.",
    stars: 5
  },
  {
    name: "Clínica Vida",
    location: "Pucallpa",
    quote: "La página web nos ayudó a recibir más consultas y ahora nuestros pacientes nos encuentran fácil.",
    stars: 5
  }
];

const logos = [
  { name: "Bodega San Martín", icon: "🏢" },
  { name: "Clínica Dental Sonrisas", icon: "🦷" },
  { name: "CVM TEL", icon: "📡" },
  { name: "Inmobiliaria Casa Nueva", icon: "🏠" },
  { name: "FarmaSalud", icon: "💊" }
];
---

<section class="bg-white py-12 lg:py-16 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="text-center mb-12 reveal">
      <span class="eyebrow">Proyectos reales, clientes reales</span>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-[#0B132B] sm:text-5xl">Ellos ya confían en nuestro trabajo</h2>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="reveal flex flex-col rounded-3xl border border-slate-100 bg-white p-8 shadow-sm hover:shadow-xl hover:border-cobalt-100 transition-all duration-500">
          <div class="flex gap-1 mb-6">
            {[...Array(t.stars)].map(() => (
              <span class="text-ember-500 text-lg">★</span>
            ))}
          </div>
          <blockquote class="flex-1 text-sm font-medium leading-7 text-slate-600 italic">
            “{t.quote}”
          </blockquote>
          <figcaption class="mt-8 pt-6 border-t border-slate-50">
            <div class="font-extrabold text-[#0B132B] group-hover:text-[#0A58CA] transition-colors">{t.name}</div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-1">{t.location}</div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12 reveal">
      <p class="text-center text-[10px] font-extrabold uppercase tracking-[0.3em] text-[#5C677D] mb-10">Negocios que han crecido con nosotros</p>
      
      <div class="relative w-full overflow-hidden before:absolute before:left-0 before:top-0 before:z-10 before:h-full before:w-20 before:bg-gradient-to-r before:from-white before:to-transparent after:absolute after:right-0 after:top-0 after:z-10 after:h-full after:w-20 after:bg-gradient-to-l after:after:from-white after:to-transparent">
        <div class="flex animate-scroll hover:[animation-play-state:paused]">
          {/* Duplicamos la lista para un scroll infinito sin saltos */}
          {[...logos, ...logos, ...logos].map(l => (
            <div class="flex items-center gap-2 grayscale hover:grayscale-0 transition-all cursor-default group mx-8 shrink-0">
              <span class="text-2xl group-hover:scale-110 transition-transform">{l.icon}</span>
              <span class="text-sm font-bold text-slate-900 whitespace-nowrap">{l.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% / 3)); }
  }

  .animate-scroll {
    animation: scroll 30s linear infinite;
    display: flex;
    width: max-content;
  }
</style>
