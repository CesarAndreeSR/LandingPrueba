---
const testimonials = [
  {
    name: "Bodega San Martín",
    location: "Pucallpa",
    quote: "El sistema nos ayudó a llevar el control de nuestra bodega. Ahora sabemos todo lo que entra y sale. 100% recomendado.",
    stars: 5
  },
  {
    name: "Clínica Dental Sonrisas",
    location: "Pucallpa",
    quote: "Nuestra clínica maneja citas, pacientes e historias clínicas en un solo sistema. Excelente soporte.",
    stars: 5
  },
  {
    name: "Clínica Vida",
    location: "Pucallpa",
    quote: "La página web nos ayudó a recibir más consultas y ahora nuestros pacientes nos encuentran fácil.",
    stars: 5
  }
];

const logos = [
  { name: "Bodega San Martín", icon: "🏢" },
  { name: "Clínica Dental Sonrisas", icon: "🦷" },
  { name: "CVM TEL", icon: "📡" },
  { name: "Inmobiliaria Casa Nueva", icon: "🏠" },
  { name: "FarmaSalud", icon: "💊" }
];
---

<section class="bg-white py-12 lg:py-16 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="text-center mb-12 reveal">
      <span class="eyebrow">Proyectos reales, clientes reales</span>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-[#0B132B] sm:text-5xl">Ellos ya confían en nuestro trabajo</h2>
    </div>

    <div class="relative">
      <!-- Botón Izquierdo -->
      <button id="prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 h-12 w-12 rounded-full bg-white border border-slate-200 shadow-lg flex items-center justify-center text-[#0B132B] hover:bg-[#0A58CA] hover:text-white hover:border-[#0A58CA] transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </button>

      <!-- Contenedor de Testimonios -->
      <div class="overflow-hidden">
        <div id="testimonials-container" class="flex gap-8 transition-transform duration-500 ease-out">
          {testimonials.map((t) => (
        <figure class="flex-shrink-0 w-full md:w-[calc(33.333%-21px)] flex flex-col rounded-3xl border border-slate-100 bg-white p-8 shadow-sm hover:shadow-xl hover:border-[#0A58CA]/20 transition-all duration-500">
          <div class="flex gap-1 mb-6">
            {[...Array(t.stars)].map(() => (
              <span class="text-[#FF6600] text-lg">★</span>
            ))}
          </div>
          <blockquote class="flex-1 text-sm font-medium leading-7 text-slate-600 italic">
            “{t.quote}”
          </blockquote>
          <figcaption class="mt-8 pt-6 border-t border-slate-50">
            <div class="font-extrabold text-[#0B132B] group-hover:text-[#0A58CA] transition-colors">{t.name}</div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-1">{t.location}</div>
          </figcaption>
        </figure>
      ))}
        </div>
      </div>

      <!-- Botón Derecho -->
      <button id="next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 h-12 w-12 rounded-full bg-white border border-slate-200 shadow-lg flex items-center justify-center text-[#0B132B] hover:bg-[#0A58CA] hover:text-white hover:border-[#0A58CA] transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>

    <div class="mt-12 reveal">
      <p class="text-center text-[10px] font-extrabold uppercase tracking-[0.3em] text-[#5C677D] mb-10">Negocios que han crecido con nosotros</p>
      
      <div class="relative w-full overflow-hidden before:absolute before:left-0 before:top-0 before:z-10 before:h-full before:w-20 before:bg-gradient-to-r before:from-white before:to-transparent after:absolute after:right-0 after:top-0 after:z-10 after:h-full after:w-20 after:bg-gradient-to-l after:after:from-white after:to-transparent">
        <div class="flex animate-scroll hover:[animation-play-state:paused]">
          {/* Duplicamos la lista para un scroll infinito sin saltos */}
          {[...logos, ...logos, ...logos].map(l => (
            <div class="flex items-center gap-2 grayscale hover:grayscale-0 transition-all cursor-default group mx-8 shrink-0">
              <span class="text-2xl group-hover:scale-110 transition-transform">{l.icon}</span>
              <span class="text-sm font-bold text-slate-900 whitespace-nowrap">{l.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% / 3)); }
  }

  .animate-scroll {
    animation: scroll 30s linear infinite;
    display: flex;
    width: max-content;
  }
</style>

<script>
  const container = document.getElementById('testimonials-container');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  let currentIndex = 0;
  const testimonials = container?.children || [];
  const totalTestimonials = testimonials.length;

  function updateCarousel() {
    if (!container) return;
    const cardWidth = testimonials[0]?.offsetWidth || 0;
    const gap = 32; // gap-8 = 32px
    const moveAmount = (cardWidth + gap) * currentIndex;
    container.style.transform = `translateX(-${moveAmount}px)`;

    // Deshabilitar botones según la posición
    if (prevBtn) prevBtn.disabled = currentIndex === 0;
    if (nextBtn) nextBtn.disabled = currentIndex >= totalTestimonials - 1;
  }

  prevBtn?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      updateCarousel();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentIndex < totalTestimonials - 1) {
      currentIndex++;
      updateCarousel();
    }
  });

  // Actualizar al cambiar el tamaño de la ventana
  window.addEventListener('resize', updateCarousel);

  // Inicializar
  updateCarousel();
</script>
