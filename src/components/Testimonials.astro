---
const testimonials = [
  {
    name: "Bodega San Martín",
    location: "Pucallpa",
    quote: "El sistema nos ayudó a llevar el control de nuestra bodega. Ahora sabemos todo lo que entra y sale. 100% recomendado.",
    stars: 5
  },
  {
    name: "Clínica Dental Sonrisas",
    location: "Pucallpa",
    quote: "Nuestra clínica maneja citas, pacientes e historias clínicas en un solo sistema. Excelente soporte.",
    stars: 5
  },
  {
    name: "Clínica Vida",
    location: "Pucallpa",
    quote: "La página web nos ayudó a recibir más consultas y ahora nuestros pacientes nos encuentran fácil.",
    stars: 5
  }
];

const logos = [
  { name: "Bodega San Martín", icon: "🏢" },
  { name: "Clínica Dental Sonrisas", icon: "🦷" },
  { name: "CVM TEL", icon: "📡" },
  { name: "Inmobiliaria Casa Nueva", icon: "🏠" },
  { name: "FarmaSalud", icon: "💊" }
];
---

<section class="bg-white py-20 lg:py-28 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="eyebrow text-cobalt-600">Proyectos reales, clientes reales</span>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Ellos ya confían en nuestro trabajo</h2>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="reveal flex flex-col rounded-3xl border border-slate-100 bg-white p-8 shadow-sm hover:shadow-xl transition-shadow">
          <div class="flex gap-1 mb-6">
            {[...Array(t.stars)].map(() => (
              <span class="text-ember-500 text-lg">★</span>
            ))}
          </div>
          <blockquote class="flex-1 text-sm font-medium leading-7 text-slate-600 italic">
            “{t.quote}”
          </blockquote>
          <figcaption class="mt-8 pt-6 border-t border-slate-50">
            <div class="font-extrabold text-ink">{t.name}</div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mt-1">{t.location}</div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-20 text-center reveal">
      <p class="text-[10px] font-extrabold uppercase tracking-[0.3em] text-slate-400 mb-10">Negocios que han crecido con nosotros</p>
      <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-8 opacity-60">
        {logos.map(l => (
          <div class="flex items-center gap-2 grayscale hover:grayscale-0 transition-all cursor-default group">
            <span class="text-2xl group-hover:scale-110 transition-transform">{l.icon}</span>
            <span class="text-sm font-bold text-slate-900">{l.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
