---
import qoriData from '../data/qori.json';
---

<div 
  id="qori-chatbot" 
  class="fixed bottom-6 right-6 z-50 font-sans"
  data-config={JSON.stringify(qoriData)}
>
  <!-- Floating Button -->
  <button
    id="qori-toggle"
    class="bg-ember-500 hover:bg-ember-600 text-white p-4 rounded-full shadow-2xl transition-all duration-300 transform hover:scale-110 active:scale-95 flex items-center justify-center group relative qori-pulse"
    aria-label="Abrir chat con Qori"
  >
    <!-- Notification Badge -->
    <span id="qori-badge" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full border-2 border-white animate-bounce hidden">
      1
    </span>
    
    <svg id="qori-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 transition-transform group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
    <svg id="qori-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Chat Window -->
  <div
    id="qori-window"
    class="hidden fixed bottom-4 left-4 right-4 h-[75vh] sm:absolute sm:bottom-20 sm:right-0 sm:left-auto sm:w-[320px] sm:h-[480px] bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden flex flex-col transition-all duration-500 opacity-0 translate-y-10 z-[1000]"
  >
    <!-- Header -->
    <div class="bg-ink text-white p-4 flex items-center justify-between relative overflow-hidden">
      <!-- Background Decorative -->
      <div class="absolute top-0 right-0 w-24 h-24 bg-cobalt-500/20 rounded-full blur-2xl -mr-12 -mt-12"></div>
      
      <div class="flex items-center gap-3 relative z-10">
        <div class="relative">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cobalt-500 to-ember-500 flex items-center justify-center font-black text-lg shadow-lg rotate-3 group-hover:rotate-0 transition-transform">
            Q
          </div>
          <span class="absolute -bottom-1 -right-1 w-3 h-3 bg-green-500 border-2 border-ink rounded-full"></span>
        </div>
        <div>
          <h3 class="font-black text-base leading-tight tracking-tight">Qori AI</h3>
          <p class="text-[9px] font-bold uppercase tracking-widest text-cobalt-200">En línea</p>
        </div>
      </div>
      
      <button id="qori-minimize" class="hover:bg-white/10 p-1.5 rounded-lg transition-all active:scale-90 relative z-10" aria-label="Cerrar chat">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Messages Container -->
    <div id="qori-messages" class="flex-1 overflow-y-auto p-5 space-y-5 bg-slate-50/50 scroll-smooth">
      <!-- Initial Message -->
      <div class="flex flex-col items-start max-w-[90%] gsap-reveal-chat">
        <div class="bg-white border border-slate-100 text-ink p-3.5 rounded-2xl rounded-tl-none shadow-sm text-xs font-medium leading-relaxed">
          {qoriData.mensaje_inicial}
        </div>
        <span class="text-[8px] font-bold text-slate-400 mt-2 ml-1 uppercase tracking-widest">Qori • Ahora</span>
      </div>
    </div>

    <!-- Quick Suggestions -->
    <div class="px-5 py-2.5 bg-white border-t border-slate-50 flex gap-2 overflow-x-auto whitespace-nowrap no-scrollbar">
      {qoriData.sugerencias.map((sugerencia) => (
        <button class="qori-suggestion px-3 py-1.5 bg-slate-50 hover:bg-cobalt-50 text-cobalt-600 text-[10px] font-black rounded-lg border border-slate-100 transition-all active:scale-95 uppercase tracking-wider">
          {sugerencia}
        </button>
      ))}
    </div>

    <!-- Input Area -->
    <div class="p-4 bg-white border-t border-slate-100">
      <form id="qori-form" class="relative group">
        <input
          type="text"
          id="qori-input"
          placeholder="Escribe tu duda..."
          class="w-full bg-slate-50 border border-slate-100 rounded-xl pl-4 pr-12 py-3 text-xs font-bold text-ink focus:outline-none focus:ring-2 focus:ring-cobalt-500/20 focus:border-cobalt-500 transition-all placeholder:text-slate-400"
          autocomplete="off"
        />
        <button
          type="submit"
          class="absolute right-1.5 top-1/2 -translate-y-1/2 bg-ink hover:bg-cobalt-500 text-white p-2 rounded-lg transition-all active:scale-90 disabled:opacity-50 disabled:pointer-events-none group-hover:shadow-lg shadow-cobalt-500/20"
          id="qori-send"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  #qori-window.show {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  /* Custom scrollbar for message container */
  #qori-messages::-webkit-scrollbar {
    width: 4px;
  }
  #qori-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #qori-messages::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  #qori-messages::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  /* Pulse animation for the button */
  .qori-pulse::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: inherit;
    border-radius: inherit;
    z-index: -1;
    opacity: 0.7;
    animation: qori-pulse-anim 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes qori-pulse-anim {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(1.6); opacity: 0; }
  }
</style>

<script>
  import { initQori } from '../scripts/qori.js';
  initQori('qori-chatbot');
</script>
