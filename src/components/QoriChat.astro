---
import qoriData from '../data/qori.json';
---

<div 
  id="qori-chatbot" 
  class="fixed bottom-6 right-6 z-50 font-sans"
  data-config={JSON.stringify(qoriData)}
>
  <!-- Floating Button -->
  <button
    id="qori-toggle"
    class="bg-ember-500 hover:bg-ember-600 text-white p-4 rounded-full shadow-2xl transition-all duration-300 transform hover:scale-110 active:scale-95 flex items-center justify-center group relative qori-pulse"
    aria-label="Abrir chat con Qori"
  >
    <!-- Notification Badge -->
    <span id="qori-badge" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full border-2 border-white animate-bounce hidden">
      1
    </span>
    
    <svg id="qori-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 transition-transform group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
    <svg id="qori-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Chat Window -->
  <div
    id="qori-window"
    class="hidden absolute bottom-20 right-0 w-[350px] sm:w-[400px] h-[500px] bg-white rounded-2xl shadow-2xl border border-bone-200 overflow-hidden flex flex-col transition-all duration-300 opacity-0 translate-y-4"
  >
    <!-- Header -->
    <div class="bg-cobalt-600 text-white p-4 flex items-center justify-between shadow-md">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-ember-500 flex items-center justify-center font-bold text-lg shadow-inner">
          Q
        </div>
        <div>
          <h3 class="font-bold text-lg leading-tight">Qori</h3>
          <p class="text-xs text-cobalt-100 flex items-center gap-1">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            En línea ahora
          </p>
        </div>
      </div>
      <button id="qori-minimize" class="hover:bg-cobalt-700 p-2 rounded-lg transition-colors" aria-label="Minimizar chat">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    <!-- Messages Container -->
    <div id="qori-messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-bone-50 scrollbar-thin scrollbar-thumb-cobalt-200 scrollbar-track-transparent">
      <!-- Initial Message -->
      <div class="flex flex-col items-start max-w-[85%]">
        <div class="bg-white border border-bone-200 text-ink p-3 rounded-2xl rounded-tl-none shadow-sm">
          {qoriData.mensaje_inicial}
        </div>
        <span class="text-[10px] text-gray-400 mt-1 ml-1">Justo ahora</span>
      </div>
    </div>

    <!-- Quick Suggestions -->
    <div class="px-4 py-2 bg-white flex gap-2 overflow-x-auto whitespace-nowrap no-scrollbar">
      {qoriData.sugerencias.map((sugerencia) => (
        <button class="qori-suggestion px-3 py-1 bg-bone-100 hover:bg-cobalt-50 text-cobalt-700 text-xs rounded-full border border-bone-200 transition-colors">
          {sugerencia}
        </button>
      ))}
    </div>

    <!-- Input Area -->
    <form id="qori-form" class="p-4 border-t border-bone-200 bg-white flex gap-2">
      <input
        type="text"
        id="qori-input"
        placeholder="Escribe tu mensaje..."
        class="flex-1 border border-bone-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500 focus:border-transparent transition-all"
        autocomplete="off"
      />
      <button
        type="submit"
        class="bg-cobalt-600 hover:bg-cobalt-700 text-white p-2 rounded-xl transition-all active:scale-95 disabled:opacity-50"
        id="qori-send"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  #qori-window.show {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  /* Custom scrollbar for message container */
  #qori-messages::-webkit-scrollbar {
    width: 4px;
  }
  #qori-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  #qori-messages::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  #qori-messages::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  /* Pulse animation for the button */
  .qori-pulse::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: inherit;
    border-radius: inherit;
    z-index: -1;
    opacity: 0.7;
    animation: qori-pulse-anim 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes qori-pulse-anim {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(1.6); opacity: 0; }
  }
</style>

<script>
  import { initQori } from '../scripts/qori.js';
  initQori('qori-chatbot');
</script>
