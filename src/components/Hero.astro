---
const { whatsapp } = Astro.props;
---

<section class="relative bg-white pt-24 pb-32 lg:pt-32 lg:pb-40 overflow-hidden">
  <!-- Ultra Modern Background Effects -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none z-0">
    <div class="absolute top-[-10%] left-[-10%] w-[600px] h-[600px] bg-cobalt-500/5 rounded-full blur-[100px] animate-pulse-soft"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-ember-500/5 rounded-full blur-[80px] animate-pulse-soft" style="animation-delay: 4s;"></div>
  </div>
  
  <div class="relative mx-auto max-w-7xl px-5 lg:px-8 z-10">
    <div class="flex flex-col items-center text-center max-w-5xl mx-auto">
      <h1 class="gsap-reveal text-5xl font-black tracking-tight text-ink sm:text-7xl lg:text-9xl leading-[0.85] mb-10">
        Impulsa tu <br />
        <span class="text-cobalt-500">negocio hoy.</span>
      </h1>

      <p class="gsap-reveal text-lg sm:text-xl text-slate-500 leading-relaxed mb-16 max-w-2xl font-medium">
        Creamos herramientas digitales fáciles de usar para que tu negocio sea más ordenado, venda más y crezca sin complicaciones.
      </p>

      <div class="gsap-reveal flex flex-col sm:flex-row items-center gap-6 mb-24 w-full sm:w-auto">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-saas btn-saas-primary w-full sm:w-auto text-base uppercase tracking-widest active:scale-95">
          Pedir información
        </a>
        <a href="#servicios" class="btn-saas btn-saas-secondary w-full sm:w-auto text-base uppercase tracking-widest active:scale-95">
          Ver servicios
        </a>
      </div>
    </div>

    <!-- Ultra Premium Hero Media -->
    <div class="relative gsap-reveal mt-10">
      <div class="relative mx-auto max-w-5xl">
        <div class="relative group/hero">
          <!-- Main Laptop Mockup -->
          <div class="relative z-10 transform group-hover/hero:scale-[1.01] transition-transform duration-1000 ease-out">
            <img 
              src="/img/laptop.png" 
              alt="Sistema Intihawua" 
              class="w-full h-auto drop-shadow-[0_30px_50px_rgba(0,0,0,0.08)]"
            />
          </div>
          
          <!-- Floating UI Cards (Glassmorphism) -->
          <div class="absolute -top-6 -left-6 lg:-left-10 glass p-5 rounded-2xl shadow-xl hidden lg:block animate-float z-20 max-w-[240px]">
            <div class="flex items-center gap-3 mb-2">
              <div class="h-10 w-10 rounded-xl bg-emerald-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
              </div>
              <div>
                <div class="text-lg font-black text-ink">Más ventas</div>
                <div class="text-[8px] font-bold uppercase tracking-widest text-slate-400">Control total</div>
              </div>
            </div>
            <p class="text-[10px] text-slate-500 font-medium leading-relaxed">Todo lo que necesitas para que tu empresa funcione mejor.</p>
          </div>

          <div class="absolute bottom-4 -right-6 lg:-right-12 w-56 gsap-reveal hidden lg:block z-20" style="transition-delay: 0.5s;">
             <div class="relative group/mobile">
               <img 
                src="/img/celular.png" 
                alt="App Intihawua" 
                class="w-full h-auto transform rotate-3 group-hover/mobile:rotate-0 transition-transform duration-1000"
              />
             </div>
          </div>

          <!-- Abstract shapes for depth -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[110%] h-[110%] border border-slate-100 rounded-full opacity-40 pointer-events-none -z-10"></div>
        </div>
      </div>
    </div>

    <!-- High-Value Stats -->
    <div class="mt-24 grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 gsap-reveal">
      {[
        { n: "100+", t: "Negocios felices", i: "🏆" },
        { n: "24/7", t: "Te ayudamos siempre", i: "🛡️" },
        { n: "100%", t: "Seguro en internet", i: "☁️" },
        { n: "SUNAT", t: "Todo legal", i: "📄" }
      ].map(stat => (
        <div class="group flex flex-col items-center lg:items-start">
          <div class="text-xl mb-2 group-hover:scale-110 transition-transform duration-300">{stat.i}</div>
          <div class="text-3xl font-black text-ink mb-1 tracking-tighter group-hover:text-cobalt-500 transition-colors">{stat.n}</div>
          <div class="text-[9px] font-extrabold uppercase tracking-[0.2em] text-slate-400 group-hover:text-ember-500 transition-colors">{stat.t}</div>
        </div>
      ))}
    </div>
  </div>
</section>
