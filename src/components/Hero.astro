---
const { whatsapp } = Astro.props;
---

<section class="relative bg-gradient-to-b from-white to-blue-600 min-h-screen flex flex-col justify-center pt-32 pb-0 overflow-hidden">
  <!-- Ultra Modern Background Effects -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none z-0">
    <div class="absolute top-[-10%] left-[-10%] w-[600px] h-[600px] bg-[#0A58CA]/22 rounded-full blur-[100px] animate-pulse-soft"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-[#FF6600]/18 rounded-full blur-[80px] animate-pulse-soft" style="animation-delay: 4s;"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8 z-10 w-full">
    <!-- Contenedor del texto centrado -->
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Título: Tamaño reducido a 5xl/6xl y espacio inferior reducido -->
      <h1 class="gsap-reveal text-4xl font-black tracking-tight text-slate-900 sm:text-5xl lg:text-6xl leading-[1.1] mb-5">
        ¿Estás aprovechando todo el <br />
        <span class="text-[#0099FF]">potencial de tu negocio?</span>
      </h1>

      <!-- Párrafo: Tamaño ligeramente ajustado y margen reducido -->
      <p class="gsap-reveal text-base sm:text-lg text-[#5C677D] leading-relaxed mb-6 max-w-2xl font-medium">
        Creamos herramientas digitales fáciles de usar para que tu negocio sea más ordenado, venda más y crezca sin complicaciones.
      </p>

      <!-- Botones: Espacio inferior reducido (mb-6) -->
      <div class="gsap-reveal flex flex-col sm:flex-row items-center gap-4 mb-6 w-full sm:w-auto">
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-xl bg-[#FF6600] text-white text-sm font-black uppercase tracking-[0.1em] transition-all hover:bg-[#FFAA00] hover:shadow-lg hover:shadow-[#FF6600]/30 active:scale-95">
          Pedir información
        </a>
        <a href="#servicios" class="px-8 py-3.5 rounded-xl border-2 border-slate-300 text-slate-700 hover:text-slate-900 text-sm font-black uppercase tracking-[0.1em] transition-all hover:bg-slate-50 hover:border-slate-400 active:scale-95">
          Ver servicios
        </a>
      </div>
    </div>

    <!-- Ultra Premium Hero Media: Contenedor de imagen reducido para evitar scroll -->
    <div class="relative gsap-reveal mt-0">
      <!-- Cambié max-w-5xl por max-w-3xl y xl:max-w-4xl para que la laptop sea un poco más chica -->
      <div class="relative mx-auto max-w-3xl xl:max-w-4xl">
        <div class="relative group/hero">
          <!-- Main Laptop Mockup -->
          <div class="relative z-10 transform group-hover/hero:scale-[1.01] transition-transform duration-1000 ease-out">
            <img 
              src="/img/laptop.png" 
              alt="Sistema Intihawua" 
              class="w-full h-auto drop-shadow-[0_30px_50px_rgba(0,0,0,0.08)]"
            />
          </div>
          
          <!-- Floating UI Cards (Glassmorphism) -->
          <div class="absolute -top-4 -left-4 lg:-top-6 lg:-left-10 glass p-4 lg:p-5 rounded-2xl shadow-xl hidden lg:block animate-float z-20 max-w-[200px] lg:max-w-[240px]">
            <div class="flex items-center gap-3 mb-2">
              <div class="h-8 w-8 lg:h-10 lg:w-10 rounded-xl bg-emerald-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 lg:h-5 lg:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
              </div>
              <div>
                <div class="text-base lg:text-lg font-black text-ink">Más ventas</div>
                <div class="text-[7px] lg:text-[8px] font-bold uppercase tracking-widest text-slate-400">Control total</div>
              </div>
            </div>
            <p class="text-[9px] lg:text-[10px] text-slate-500 font-medium leading-relaxed">Todo lo que necesitas para que tu empresa funcione mejor.</p>
          </div>

          <div class="absolute bottom-2 -right-4 lg:bottom-4 lg:-right-12 w-40 lg:w-48 gsap-reveal hidden lg:block z-20" style="transition-delay: 0.5s;">
             <div class="relative group/mobile">
               <img 
                src="/img/celular.png" 
                alt="App Intihawua" 
                class="w-full h-auto transform rotate-3 group-hover/mobile:rotate-0 transition-transform duration-1000"
              />
             </div>
          </div>

          <!-- Abstract shapes for depth -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[110%] h-[110%] border border-slate-100 rounded-full opacity-40 pointer-events-none -z-10"></div>
        </div>
      </div>
    </div>
  </div>
</section>