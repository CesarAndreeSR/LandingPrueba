---
const steps = [
  {
    number: "01",
    title: "Reunión inicial",
    description: "Conversamos sobre tu negocio para entender qué es lo que necesitas exactamente.",
    icon: "fi fi-br-users"
  },
  {
    number: "02",
    title: "Diseño de tu página",
    description: "Creamos un diseño moderno y profesional que le guste a tus clientes.",
    icon: "fi fi-br-palette"
  },
  {
    number: "03",
    title: "Construcción",
    description: "Nuestros expertos programan tu sistema o página con la mejor tecnología.",
    icon: "fi fi-br-settings"
  },
  {
    number: "04",
    title: "Pruebas",
    description: "Revisamos que todo funcione perfecto antes de entregarte el proyecto.",
    icon: "fi fi-br-shield-check"
  },
  {
    number: "05",
    title: "Lanzamiento",
    description: "Ponemos tu sistema en marcha y te enseñamos a usarlo paso a paso.",
    icon: "fi fi-br-rocket-lunch"
  }
];

const techs = [
  { name: "Laravel", color: "text-[#FF2D20]" },
  { name: "PHP", color: "text-[#777BB4]" },
  { name: "React", color: "text-[#61DAFB]" },
  { name: "Git", color: "text-[#F05032]" },
  { name: "Tailwind", color: "text-[#06B6D4]" },
  { name: "JavaScript", color: "text-[#3178C6]" },
  { name: "Postgres", color: "text-[#4169E1]" }
];
---

<section id="proceso" class="bg-dark-gradient py-12 lg:py-16 relative overflow-hidden">
  <!-- Dynamic grid background -->
  <div class="absolute inset-0 bg-grid opacity-30"></div>

  <!-- Animated gradient background -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
    <div class="absolute top-[-50%] left-[-20%] w-[800px] h-[800px] bg-[#0A58CA]/25 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-[-30%] right-[-10%] w-[600px] h-[600px] bg-[#FF6600]/18 rounded-full blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 lg:px-8 relative z-10">
    <div class="max-w-4xl mb-16 gsap-reveal">
      <span class="eyebrow">Cómo trabajamos</span>
      <h2 class="mt-6 text-4xl font-black tracking-tight text-white sm:text-6xl leading-[0.9]">Pasos simples para crear <span class="text-[#FF6600]">tu proyecto.</span></h2>
    </div>

    <!-- Process Flow -->
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-10 gsap-reveal">
      {steps.map((step, index) => (
        <div class="group relative animate-fade-in-up" style={`animation-delay: ${index * 0.15}s;`}>
          <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
            <div class="flex h-20 w-20 items-center justify-center rounded-[2rem] bg-white border border-slate-100 shadow-lg transition-all duration-700 group-hover:-translate-y-2 group-hover:shadow-[#0A58CA]/20 group-hover:border-[#0A58CA]/30 group-hover:scale-110">
              <i class={`${step.icon} text-3xl group-hover:scale-110 transition-transform duration-500 text-[#0A58CA] group-hover:text-[#FF6600]`}></i>
              <!-- Step Number Badge -->
              <div class="absolute -top-2 -right-2 h-8 w-8 rounded-xl bg-[#0B132B] flex items-center justify-center text-[10px] font-black text-white shadow-xl group-hover:bg-[#FF6600] transition-colors group-hover:scale-110">
                {step.number}
              </div>
            </div>

            <h3 class="mt-8 text-xl font-black text-white tracking-tight group-hover:text-[#FF6600] transition-colors">{step.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-white/80 font-medium">
              {step.description}
            </p>
          </div>

          <!-- Connecting Arrow (Desktop) -->
          {index !== steps.length - 1 && (
            <div class="hidden lg:block absolute top-10 left-full w-full h-px border-t border-dashed border-slate-200 -translate-x-6 z-0 opacity-20 group-hover:opacity-60 transition-opacity"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
