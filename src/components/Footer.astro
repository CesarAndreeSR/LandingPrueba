---
const { nav, whatsapp } = Astro.props;

const services = [
  { label: "Sistemas POS", href: "#servicios" },
  { label: "Inventario", href: "#servicios" },
  { label: "Páginas Web", href: "#servicios" },
  { label: "Desarrollo a medida", href: "#servicios" },
];

const social = [
  { label: "Facebook", href: "#", icon: "fi fi-brands-facebook" },
  { label: "Instagram", href: "#", icon: "fi fi-brands-instagram" },
  { label: "WhatsApp", href: whatsapp, icon: "fi fi-brands-whatsapp" },
];
---

<footer class="bg-dark-gradient text-white pt-12 pb-8 overflow-hidden" id="contacto">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 mb-12">
      <!-- Left: Form -->
      <div class="bg-white/5 p-8 sm:p-10 rounded-[2.5rem] border border-white/10 shadow-2xl">
        <div class="mb-8">
          <h3 class="text-2xl font-black text-white tracking-tighter">¿Listo para empezar?</h3>
          <p class="text-[#5C677D] mt-2 font-medium text-sm">Déjanos tus datos y te contactaremos de inmediato.</p>
        </div>
        <form class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input type="text" placeholder="Nombre" class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-[#5C677D] focus:border-[#0A58CA] focus:outline-none transition-all font-bold text-sm" required />
          <input type="email" placeholder="Email" class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-[#5C677D] focus:border-[#0A58CA] focus:outline-none transition-all font-bold text-sm" required />
          <input type="tel" placeholder="WhatsApp" class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-[#5C677D] focus:border-[#0A58CA] focus:outline-none transition-all font-bold text-sm" required />
          <div class="relative">
            <select class="w-full rounded-xl bg-white/5 border border-white/10 px-5 py-3 text-[#5C677D] focus:border-[#0A58CA] focus:outline-none transition-all appearance-none font-bold text-sm" required>
              <option value="" disabled selected class="bg-ink">Tipo de proyecto</option>
              <option value="enterprise" class="bg-ink text-white">Sistema para mi empresa</option>
              <option value="saas" class="bg-ink text-white">Sistema en la nube</option>
              <option value="web-pro" class="bg-ink text-white">Página web profesional</option>
            </select>
          </div>
          <textarea rows="3" placeholder="Cuéntanos un poco de tu idea..." class="sm:col-span-2 w-full rounded-2xl bg-white/5 border border-white/10 px-5 py-3 text-white placeholder:text-[#5C677D] focus:border-[#0A58CA] focus:outline-none transition-all resize-none font-bold text-sm" required></textarea>
          <button type="submit" class="sm:col-span-2 w-full py-4 text-xs uppercase tracking-[0.2em] rounded-xl bg-[#FF6600] text-white font-black transition-all hover:bg-[#FFAA00] hover:shadow-lg hover:shadow-[#FF6600]/30 active:scale-95">
            Enviar información
          </button>
        </form>
      </div>

      <!-- Right: Branding & Contact -->
      <div class="flex flex-col justify-between">
        <div class="space-y-8">
          <div>
            <a href="#inicio" class="flex items-center gap-3">
              <img src="/IntiLogo.svg" alt="Intihawua" class="h-10 w-auto" />
              <span class="text-lg font-black uppercase tracking-[0.1em]">Intihawua</span>
            </a>
            <p class="mt-3 text-base leading-relaxed text-white/50 max-w-sm">
              Transformamos negocios con software que sí ayuda a crecer. Sin complicaciones, sin retrasos, solo resultados.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-10">
            <div>
              <h3 class="text-[10px] font-extrabold uppercase tracking-widest text-[#5C677D]">Menú</h3>
              <ul class="mt-3 space-y-3 text-sm font-bold">
                {nav.map(([label, href]) => (
                  <li><a href={href} class="text-[#5C677D] hover:text-[#0A58CA] transition-colors">{label}</a></li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-[10px] font-extrabold uppercase tracking-widest text-[#5C677D]">Contacto</h3>
              <ul class="mt-3 space-y-3 text-sm font-bold text-white/60">
                <li class="flex items-center gap-3"><i class="fi fi-bs-marker"></i> Pucallpa, Perú</li>
                <li><a href="tel:+51983134672" class="hover:text-[#0A58CA] transition-colors flex items-center gap-3"><i class="fi fi-br-phone-call"></i> +51 983 134 672</a></li>
                <li><a href="mailto:hola@intihawua.com" class="hover:text-[#0A58CA] transition-colors flex items-center gap-3"><i class="fi fi-bs-envelope"></i> hola@intihawua.com</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-8 flex gap-4">
          {social.map(s => (
            <a href={s.href} class="h-10 w-10 rounded-full border border-white/10 flex items-center justify-center hover:bg-white/5 hover:border-white/30 transition-all text-lg" aria-label={s.label}>
              <i class={s.icon}></i>
            </a>
          ))}
        </div>
      </div>
    </div>
    
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4 text-[9px] font-bold uppercase tracking-[0.1em] text-[#5C677D]">
      <p>© 2026 Intihawua. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="/privacidad" class="hover:text-[#0A58CA] transition-colors">Política de Privacidad</a>
        <a href="/condiciones" class="hover:text-[#0A58CA] transition-colors">Términos y condiciones</a>
      </div>
    </div>
  </div>
</footer>
