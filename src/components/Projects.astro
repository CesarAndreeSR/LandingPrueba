---
const projects = [
  {
    id: "pasteleria",
    title: "Sistema para Pastelería",
    tag: "Demo Disponible",
    description: "Gestión de pedidos, inventario de insumos, caja y ventas. Ideal para negocios de repostería que buscan orden.",
    image: "https://framerusercontent.com/images/pasteleria-demo.png",
    metric: "100%",
    metricLabel: "Control de stock",
    features: ["Pedidos personalizados", "Insumos y recetas", "Caja diaria"]
  },
  {
    id: "cobranzas",
    title: "Sistema de Cobranzas",
    tag: "Demo Disponible",
    description: "Control de préstamos, cuotas, intereses y seguimiento de clientes. Automatización de estados de cuenta.",
    image: "https://framerusercontent.com/images/cobranzas-demo.png",
    metric: "+40%",
    metricLabel: "Recuperación de mora",
    features: ["Calendario de pagos", "Notificaciones WhatsApp", "Reportes de mora"]
  },
  {
    id: "clinica",
    title: "Landing para Clínica Dental",
    tag: "Caso Real",
    description: "Página de captación de pacientes con reserva por WhatsApp y diseño enfocado en la confianza.",
    image: "https://framerusercontent.com/images/clinica-demo.png",
    metric: "3.4x",
    metricLabel: "Más consultas",
    features: ["Diseño Premium", "SEO Local", "Alta conversión"]
  }
];
---

<section id="proyectos" class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
      <div class="reveal max-w-2xl">
        <span class="eyebrow text-cobalt-600">SOLUCIONES QUE GENERAN RESULTADOS</span>
        <h2 class="mt-3 text-4xl font-extrabold tracking-[-0.04em] text-ink sm:text-5xl">CASOS DE ÉXITO Y DEMOSTRACIONES</h2>
      </div>
      <p class="reveal max-w-md text-lg text-slate-600">Conoce algunos de los sistemas que hemos desarrollado para ayudar a negocios a crecer y digitalizar sus procesos.</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="reveal group flex flex-col rounded-[2rem] border border-slate-200 bg-white shadow-sm hover:shadow-2xl hover:shadow-cobalt-900/10 transition-all overflow-hidden">
          <div class="relative h-64 overflow-hidden bg-slate-100">
            <img src={project.image} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded-full bg-white/90 backdrop-blur-sm text-ink text-[10px] font-extrabold uppercase tracking-widest shadow-sm">
                {project.tag}
              </span>
            </div>
          </div>
          
          <div class="p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-extrabold text-ink group-hover:text-cobalt-600 transition-colors">{project.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600 line-clamp-3">{project.description}</p>
            
            <div class="mt-6 grid grid-cols-2 gap-4 border-y border-slate-100 py-6">
               <div class="text-center">
                <div class="text-3xl font-extrabold text-ember-500">{project.metric}</div>
                <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400">{project.metricLabel}</div>
              </div>
              <ul class="space-y-1">
                {project.features.map(f => (
                  <li class="text-[11px] font-bold text-slate-500 flex items-center gap-1.5">
                    <span class="text-cobalt-500">•</span> {f}
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="mt-8">
              <button 
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border-2 border-slate-900 bg-slate-900 text-white font-bold text-sm hover:bg-white hover:text-slate-900 transition-all"
                onclick={`window.open('https://demo.intihawua.app/${project.id}', '_blank')`}
              >
                Ver Demo Real
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
