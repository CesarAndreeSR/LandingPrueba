---
const { whatsapp } = Astro.props;

const plans = [
  {
    name: "Sistema POS Básico",
    price: "S/180",
    description: "Ideal para bodegas y negocios pequeños.",
    features: ["Ventas e inventario", "Reportes básicos", "1 usuario", "Soporte incluido"],
    buttonText: "Cotizar ahora",
    featured: false
  },
  {
    name: "Sistema POS Avanzado",
    price: "S/250",
    description: "Más funciones para hacer crecer tu negocio.",
    features: ["Todo lo del plan básico", "Múltiples usuarios", "Reportes avanzados", "Integración con SUNAT", "Soporte prioritario"],
    buttonText: "Cotizar ahora",
    featured: true,
    tag: "MÁS SOLICITADO"
  },
  {
    name: "Página Web Profesional",
    price: "S/500",
    description: "Tu negocio en internet, moderno y rápido.",
    features: ["Diseño personalizado", "Responsive (móvil y desktop)", "Formulario + WhatsApp", "Hosting y dominio", "Autoadministrable"],
    buttonText: "Cotizar ahora",
    featured: false
  }
];
---

<section id="precios" class="bg-bone-50 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="mx-auto max-w-3xl text-center reveal">
      <span class="eyebrow text-ember-600">Precios claros y transparentes</span>
      <h2 class="mt-3 text-4xl font-extrabold tracking-[-0.04em] text-ink sm:text-5xl">Elige la solución que mejor se adapte a ti</h2>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-3">
      {plans.map((plan) => (
        <article class={`reveal relative flex flex-col rounded-[2.5rem] border p-8 transition-all hover:-translate-y-2 ${plan.featured ? "border-ember-500 bg-white shadow-2xl shadow-ember-500/10 z-10" : "border-slate-200 bg-white/50 shadow-sm"}`}>
          {plan.featured && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="px-6 py-1.5 rounded-full bg-ember-500 text-white text-[10px] font-extrabold uppercase tracking-widest shadow-lg">
                {plan.tag}
              </span>
            </div>
          )}
          
          <div class="mb-8">
            <h3 class="text-2xl font-extrabold text-ink">{plan.name}</h3>
            <p class="mt-2 text-sm text-slate-500 font-medium min-h-[3rem]">{plan.description}</p>
          </div>
          
          <div class="mb-8">
            <span class="text-sm font-bold text-slate-400">Desde</span>
            <div class="flex items-baseline gap-1">
              <span class="text-5xl font-extrabold tracking-tight text-ember-500">{plan.price}</span>
            </div>
          </div>
          
          <ul class="flex-1 space-y-4 mb-10">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm font-semibold text-slate-700">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 text-[10px]">✓</span>
                {feature}
              </li>
            ))}
          </ul>
          
          <a 
            href={whatsapp} 
            target="_blank" 
            rel="noopener noreferrer" 
            class={`inline-flex items-center justify-center px-8 py-4 rounded-2xl font-bold text-sm transition-all ${plan.featured ? "bg-ember-500 text-white shadow-xl shadow-ember-500/20 hover:bg-ember-600" : "border-2 border-slate-200 text-ink hover:border-cobalt-600 hover:text-cobalt-700"}`}
          >
            {plan.buttonText}
          </a>
        </article>
      ))}
    </div>
    
    <div class="mt-12 text-center reveal">
      <p class="text-sm font-medium text-slate-500">
        También desarrollamos soluciones a medida según tus necesidades. <a href="#contacto" class="text-cobalt-600 font-bold hover:underline">Contáctanos</a>.
      </p>
    </div>
  </div>
</section>
