---
const antes = [
  "Uso de papeles, cuadernos o Excel",
  "Cosas que se pierden sin saber cómo",
  "Reportes que demoran mucho tiempo",
  "Nadie te encuentra en internet",
];

const despues = [
  "Sistemas modernos y muy rápidos",
  "Control total de tus productos",
  "Reportes claros al instante",
  "Página web que da mucha confianza",
];
---

<section class="relative bg-white py-20 lg:py-32 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-4xl mb-24 gsap-reveal">
      <span class="eyebrow">El cambio en tu negocio</span>
      <h2 class="mt-6 text-4xl font-black tracking-tight text-ink sm:text-6xl leading-[0.9]">De lo antiguo a lo <span class="text-cobalt-500">moderno.</span></h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-px bg-slate-100 rounded-[3rem] overflow-hidden border border-slate-100 shadow-xl gsap-reveal">
      <!-- Antes -->
      <div class="bg-white p-12 sm:p-16 space-y-12">
        <div class="flex items-center gap-4">
          <div class="h-12 w-12 rounded-2xl bg-red-50 flex items-center justify-center text-red-500 shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </div>
          <h3 class="text-2xl font-black text-slate-300 uppercase tracking-tighter italic">Antes</h3>
        </div>
        
        <ul class="space-y-6">
          {antes.map((item) => (
            <li class="flex items-start gap-4 text-lg font-bold text-slate-300">
              <span class="mt-2 h-2 w-2 rounded-full bg-slate-200 shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Después -->
      <div class="bg-slate-50 p-12 sm:p-16 space-y-12 relative group">
        <!-- Premium Floating Badge -->
        <div class="absolute top-0 right-0 p-8">
          <div class="h-16 w-16 rounded-2xl bg-cobalt-500 flex items-center justify-center text-white shadow-xl shadow-cobalt-500/30 animate-pulse-soft">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <h3 class="text-2xl font-black text-cobalt-500 uppercase tracking-tighter">Ahora</h3>
        </div>
        
        <ul class="space-y-6">
          {despues.map((item) => (
            <li class="flex items-start gap-4 text-lg font-black text-ink">
              <span class="mt-2 h-2.5 w-2.5 rounded-full bg-cobalt-500 shrink-0 shadow-[0_0_8px_rgba(6,109,200,0.5)]"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
