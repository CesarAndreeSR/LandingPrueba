---
import LayoutNoPreloader from '../layouts/LayoutNoPreloader.astro';

const nav = [
  ["Inicio", "/#inicio"],
  ["Servicios", "/#servicios"],
  ["Proceso", "/#proceso"],
  ["Nosotros", "/#nosotros"],
  ["Testimonios", "/#testimonios"],
  ["FAQ", "/#faq"],
];

const whatsapp = "https://wa.me/51983134672";

const webDemos = [
  {
    name: "Página Clínica Premium",
    url: "https://demo.intihawua.app/clinica",
    description: "Sitio web profesional para clínicas y centros médicos con sistema de citas y servicios.",
    image: "/img/clinica-preview.png",
    status: "available"
  },
  {
    name: "Landing Page E-commerce",
    url: "#",
    description: "Página de aterrizaje optimizada para ventas de productos online.",
    image: "/img/ecommerce-preview.png",
    status: "coming-soon"
  },
  {
    name: "Página Corporativa",
    url: "#",
    description: "Sitio web institucional para empresas con secciones de servicios y contacto.",
    image: "/img/corporate-preview.png",
    status: "coming-soon"
  },
  {
    name: "Restaurante Premium",
    url: "#",
    description: "Página web para restaurantes con menú digital y sistema de reservas.",
    image: "/img/restaurant-preview.png",
    status: "coming-soon"
  }
];
---

<LayoutNoPreloader title="Demos de Páginas Web - Intihawua" {nav} {whatsapp}>
  <section class="bg-[#0B132B] pt-24 pb-16">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <h1 class="text-4xl font-black text-white sm:text-5xl mb-4">Demos de Páginas Web</h1>
      <p class="text-[#5C677D] text-lg">Explora las páginas web que hemos creado para nuestros clientes</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {webDemos.map((demo) => (
          <div class={`relative rounded-2xl overflow-hidden border-2 transition-all group ${
            demo.status === 'available' 
              ? 'bg-white border-slate-100 hover:border-[#0A58CA] hover:shadow-xl hover:shadow-[#0A58CA]/10 hover:-translate-y-2' 
              : 'bg-slate-50 border-slate-200 opacity-60'
          }`}>
            <div class="aspect-[4/3] bg-gradient-to-br from-slate-100 to-slate-200 relative overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="text-center">
                  <div class="h-20 w-20 mx-auto mb-4 rounded-2xl bg-white shadow-lg flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#0A58CA]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                </div>
              </div>
              <div class="absolute top-4 right-4">
                {demo.status === 'available' ? (
                  <span class="px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-[#0A58CA] text-white rounded-full shadow-lg">Disponible</span>
                ) : (
                  <span class="px-3 py-1 text-[10px] font-black uppercase tracking-wider bg-slate-200 text-slate-600 rounded-full">Próximamente</span>
                )}
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-black text-[#0B132B] mb-2">{demo.name}</h3>
              <p class="text-sm text-[#5C677D] mb-4 line-clamp-2">{demo.description}</p>
              {demo.status === 'available' ? (
                <a 
                  href={demo.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 w-full justify-center px-6 py-3 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl bg-[#0A58CA] text-white transition-all hover:bg-[#FF6600] hover:shadow-lg hover:shadow-[#0A58CA]/30 active:scale-95"
                >
                  <span>Ver Demo</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ) : (
                <button 
                  disabled
                  class="inline-flex items-center gap-2 w-full justify-center px-6 py-3 text-[10px] font-black uppercase tracking-[0.2em] rounded-xl bg-slate-200 text-slate-400 cursor-not-allowed"
                >
                  <span>En desarrollo</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 text-center">
        <div class="bg-gradient-to-r from-[#0A58CA]/10 to-[#FF6600]/10 border-2 border-[#0A58CA] rounded-3xl p-10 max-w-3xl mx-auto">
          <div class="flex items-center justify-center gap-4 mb-6">
            <div class="h-16 w-16 rounded-2xl bg-[#0A58CA] flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </div>
            <div class="text-left">
              <h3 class="text-2xl font-black text-[#0B132B]">¿Quieres una página web personalizada?</h3>
              <p class="text-[#5C677D]">Creamos páginas web profesionales adaptadas a tu negocio.</p>
            </div>
          </div>
          <a 
            href={whatsapp} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-10 py-4 text-xs font-black uppercase tracking-[0.2em] rounded-xl bg-[#FF6600] text-white transition-all hover:bg-[#FFAA00] hover:shadow-lg hover:shadow-[#FF6600]/30 active:scale-95"
          >
            Solicitar Presupuesto
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
